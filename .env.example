# Copie para .env — ou use scripts/with-op.sh, que exporta os segredos direto do 1Password.
DATABASE_URL=postgres://motor:motor@localhost:55432/motor
ASAAS_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=            # $aact_hmlg_... (sandbox) | $aact_prod_... (produção) — o prefixo tem que bater com ASAAS_URL
ASAAS_WEBHOOK_TOKEN=      # ≥32 chars (obrigatório), nosso; o Asaas devolve em asaas-access-token
ODOO_URL=                 # https://<base>.odoo.com (duplicata de teste até o S0.3; produção só no gate R1)
ODOO_DB=
ODOO_API_KEY=
ODOO_WEBHOOK_KEY=         # ≥32 chars (obrigatório); token nosso, embutido na URL que a regra do Odoo chama (?k=)
WEBHOOK_PUBLIC_URL=       # só pro job register-asaas-webhook: https://<host>/webhook-asaas
ALERT_EMAIL=
CONSOLE_TOKEN=            # ≥32 chars; sem ele a API /api/v1 responde 503
PORT=8787
