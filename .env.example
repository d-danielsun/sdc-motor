# Copie para .env — ou use scripts/with-op.sh, que exporta os segredos direto do 1Password.
DATABASE_URL=postgres://motor:motor@localhost:55432/motor
ASAAS_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=            # $aact_hmlg_... (sandbox) | $aact_prod_... (produção) — o prefixo tem que bater com ASAAS_URL
ASAAS_WEBHOOK_TOKEN=      # 32–255 chars, nosso; o Asaas devolve em asaas-access-token
ODOO_URL=https://sdctech-danieltestes.odoo.com
ODOO_DB=sdctech-danieltestes
ODOO_API_KEY=
ODOO_WEBHOOK_KEY=         # token nosso, embutido na URL que a regra do Odoo chama (?k=)
ALERT_EMAIL=
CONSOLE_TOKEN=            # ≥32 chars; sem ele a API /api/v1 responde 503
PORT=8787
